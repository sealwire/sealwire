{
  "name": "sealwire",
  "version": "0.10.0",
  "description": "Local-first, privacy-first control plane for coding agents (Codex & Claude Code) with optional public broker pairing.",
  "license": "Elastic-2.0",
  "author": "Yikai Lan <sealwire.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sealwire/sealwire.git"
  },
  "homepage": "https://github.com/sealwire/sealwire#readme",
  "bugs": "https://github.com/sealwire/sealwire/issues",
  "type": "module",
  "bin": {
    "sealwire": "./scripts/sealwire.mjs"
  },
  "files": [
    "bin/**",
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "README.md",
    "crates/**",
    "claude-worker/worker.mjs",
    "claude-worker/protocol.mjs",
    "claude-worker/sdk-mapping.mjs",
    "claude-worker/session-options.mjs",
    "claude-worker/session-page.mjs",
    "claude-worker/progress-tracker.mjs",
    "claude-worker/permissions.mjs",
    "claude-worker/ask-user-question.mjs",
    "claude-worker/file-diff.mjs",
    "claude-worker/native-binary-check.mjs",
    "claude-worker/package.json",
    "scripts/sealwire-browser.mjs",
    "scripts/sealwire.mjs",
    "web/**"
  ],
  "engines": {
    "node": ">=18"
  },
  "config": {
    "public_broker_origin": ""
  },
  "scripts": {
    "start": "node scripts/sealwire.mjs",
    "lint": "eslint .",
    "dev": "vite --host",
    "dev:full": "scripts/with-private.sh node scripts/dev-full.mjs",
    "dev:full:local": "RELAY_DEV_LOCALHOST_ONLY=1 scripts/with-private.sh node scripts/dev-full.mjs",
    "dev:restart": "scripts/with-private.sh sh scripts/restart-dev.sh",
    "dev:restart:local": "scripts/with-private.sh sh scripts/restart-dev.sh --local",
    "dev:restart:cloud": "scripts/with-private.sh sh scripts/restart-dev-cloud.sh",
    "dev:restart:cloud:pg": "scripts/with-private.sh sh scripts/restart-dev-cloud-pg.sh",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:prepare-sidecar": "node scripts/tauri-prepare-sidecar.mjs",
    "desktop:check": "node scripts/tauri-before-build.mjs && cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "pretest": "npm run test:browser:install:ci",
    "test": "node --test claude-worker/*.test.mjs frontend/*.test.mjs frontend/desktop/*.test.mjs frontend/shared/*.test.mjs frontend/local/*.test.mjs frontend/local/session/*.test.mjs frontend/local/transcript/*.test.mjs frontend/remote/*.test.mjs frontend/remote/__tests__/*.test.mjs frontend/remote/transcript/*.test.mjs scripts/*.test.mjs scripts/e2e/*.test.mjs scripts/e2e/harness/*.test.mjs && vite build",
    "test:harness": "node --test scripts/e2e/harness/*.test.mjs",
    "test:message-drop-harness": "cargo test -p relay-server replay_harness -- --nocapture && cargo test -p relay-server compact_for_broker_trims_many_file_changes_without_clearing_transcript -- --nocapture",
    "test:review-recap-modes": "node scripts/review-recap-modes-e2e.mjs",
    "test:cwd-drift": "node scripts/cwd-drift-e2e.mjs",
    "test:private-frontend": "node --test crates/sealwire-private/frontend/*.test.mjs",
    "test:task-team": "node scripts/task-team-e2e.mjs",
    "test:browser:tasks": "npm run build && npm run build:relay:private && E2E_USE_BUILT_BINARIES=1 node scripts/browser-tasks-screen-e2e.mjs",
    "test:browser:orch-proposal-scroll": "node scripts/browser-orchestrator-proposal-scroll-e2e.mjs",
    "build": "vite build",
    "build:relay": "cargo build -p relay-server",
    "build:relay:private": "cargo build -p relay-server --features private",
    "prepare": "node scripts/install-git-hooks.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "scripts/check-no-private.sh",
    "preview": "vite preview --host",
    "smoke:pairing": "node scripts/pairing-smoke.mjs",
    "test:browser:smoke": "npm run build && node scripts/browser-page-smoke-e2e.mjs",
    "test:browser:desktop-launcher": "npm run build && node scripts/browser-desktop-launcher-e2e.mjs",
    "test:claude:provider": "node scripts/claude-provider-e2e.mjs",
    "test:cursor:provider": "node scripts/cursor-provider-e2e.mjs",
    "test:cursor:delete": "node scripts/cursor-session-delete-e2e.mjs",
    "test:browser:cursor-delete": "npm run build && node scripts/browser-cursor-delete-e2e.mjs",
    "test:browser:cursor-view-only-history": "npm run build && node scripts/browser-cursor-view-only-history-e2e.mjs",
    "test:browser:cursor-view-only-tail-gap": "npm run build && node scripts/browser-cursor-view-only-tail-gap-e2e.mjs",
    "test:browser:cursor-active-tail": "npm run build && node scripts/browser-cursor-active-tail-e2e.mjs",
    "test:claude:browser": "node scripts/e2e/run-browser-suite.mjs --suite real-provider",
    "test:claude": "npm run test:claude:provider && npm run test:claude:browser",
    "test:browser:install": "playwright install chromium",
    "test:browser:install:ci": "playwright install --with-deps chromium",
    "test:browser:pairing": "node scripts/e2e/run-browser-suite.mjs --suite self-hosted",
    "test:browser:pairing:fake": "node scripts/e2e/run-browser-suite.mjs --suite self-hosted --fake",
    "test:browser:local-delete": "npm run build && node scripts/browser-local-delete-e2e.mjs",
    "test:browser:local-session": "npm run build && node scripts/browser-local-session-e2e.mjs",
    "test:browser:local-workspace-repair": "npm run build && AGENT_PROVIDERS=fake node scripts/browser-local-workspace-repair-e2e.mjs",
    "test:browser:workflow-code-flow": "npm run build && AGENT_PROVIDERS=fake node scripts/workflow-code-flow-e2e.mjs",
    "test:browser:local-thread-interleaving": "npm run build && AGENT_PROVIDERS=fake node scripts/browser-local-thread-interleaving-e2e.mjs",
    "test:browser:local-thread-settings": "npm run build && AGENT_PROVIDERS=fake node scripts/browser-local-thread-settings-e2e.mjs",
    "test:browser:dialog-menus": "npm run build && node scripts/browser-mobile-dialog-menus-e2e.mjs",
    "test:browser:local-view-only-models": "npm run build && npm run build:relay && E2E_USE_BUILT_BINARIES=1 node scripts/browser-local-view-only-models-e2e.mjs",
    "test:browser:model-label-stability": "node scripts/browser-model-label-stability-e2e.mjs",
    "test:browser:local-permission-modes": "npm run build && AGENT_PROVIDERS=fake FAKE_PROVIDER_ENFORCE_APPROVALS=1 node scripts/browser-local-permission-modes-e2e.mjs",
    "test:browser:local-session-tab-scroll": "npm run build && AGENT_PROVIDERS=fake node scripts/browser-local-session-tab-scroll-e2e.mjs",
    "test:browser:local-thread-groups": "npm run build && node scripts/browser-local-thread-groups-e2e.mjs",
    "test:browser:local-projects": "npm run build && AGENT_PROVIDERS=fake node scripts/browser-local-projects-e2e.mjs",
    "test:browser:local-shell-redesign": "npm run build && AGENT_PROVIDERS=fake node scripts/browser-local-shell-redesign-e2e.mjs",
    "test:browser:local-history-scroll": "npm run build && node scripts/browser-local-history-scroll-e2e.mjs",
    "test:browser:scroll-to-bottom": "npm run build && npm run build:relay && E2E_USE_BUILT_BINARIES=1 AGENT_PROVIDERS=fake node scripts/browser-scroll-to-bottom-e2e.mjs",
    "test:browser:stick-to-bottom": "npm run build && npm run build:relay && E2E_USE_BUILT_BINARIES=1 AGENT_PROVIDERS=fake node scripts/browser-stick-to-bottom-e2e.mjs",
    "test:browser:local-multi-live-follow": "npm run build && node scripts/browser-local-multi-live-follow-e2e.mjs",
    "test:browser:local-drawer-scroll": "npm run build && AGENT_PROVIDERS=fake node scripts/browser-local-drawer-scroll-e2e.mjs",
    "test:browser:local-transcript-load": "npm run build && AGENT_PROVIDERS=fake node scripts/browser-local-transcript-load-e2e.mjs",
    "test:browser:local-allowed-roots": "npm run build && node scripts/browser-local-allowed-roots-e2e.mjs",
    "test:browser:local-file-diff": "npm run build && node scripts/browser-local-file-diff-e2e.mjs",
    "test:browser:local-file-diff-cards": "npm run build && AGENT_PROVIDERS=fake node scripts/browser-local-file-diff-cards-e2e.mjs",
    "test:browser:local-file-diff-path": "npm run build && node scripts/browser-local-file-diff-path-e2e.mjs",
    "test:browser:local-command-group": "npm run build && AGENT_PROVIDERS=fake node scripts/browser-local-command-group-e2e.mjs",
    "test:browser:local-auth": "npm run build && node scripts/browser-local-auth-e2e.mjs",
    "test:browser:local-core:fake": "node scripts/e2e/run-browser-suite.mjs --suite local-core --fake",
    "test:browser:local-full:fake": "node scripts/e2e/run-browser-suite.mjs --suite local-full --fake",
    "test:browser:public-enrollment": "npm run build && node scripts/browser-public-enrollment-e2e.mjs",
    "test:browser:public-broker": "npm run build && node scripts/browser-public-broker-e2e.mjs",
    "test:browser:public-reclaim": "npm run build && node scripts/browser-public-reclaim-e2e.mjs",
    "test:browser:public-refresh": "npm run build && node scripts/browser-public-refresh-e2e.mjs",
    "test:browser:public-persistence": "npm run build && node scripts/browser-public-persistence-e2e.mjs",
    "test:browser:public-revoke": "npm run build && node scripts/browser-public-revoke-e2e.mjs",
    "test:browser:public-long-transcript": "npm run build && node scripts/browser-public-long-transcript-e2e.mjs",
    "test:browser:remote-mobile-header": "npm run build && node scripts/browser-remote-mobile-header-e2e.mjs",
    "test:browser:remote-new-session-menus": "npm run build && node scripts/browser-remote-new-session-menus-e2e.mjs",
    "test:browser:cjk-project-name": "npm run build && node scripts/browser-remote-cjk-project-name-e2e.mjs",
    "test:browser:rail-toggle-align": "npm run build && AGENT_PROVIDERS=fake node scripts/browser-rail-toggle-align-e2e.mjs",
    "test:browser:public-transcript-delta": "npm run build && node scripts/browser-public-transcript-delta-e2e.mjs",
    "test:browser:public-thread-interleaving": "npm run build && AGENT_PROVIDERS=fake node scripts/browser-public-thread-interleaving-e2e.mjs",
    "test:browser:public-thread-settings": "npm run build && AGENT_PROVIDERS=fake node scripts/browser-public-thread-settings-e2e.mjs",
    "test:browser:public-settings-load": "npm run build && AGENT_PROVIDERS=fake node scripts/browser-public-settings-load-e2e.mjs",
    "test:browser:public-remote-follow": "npm run build && node scripts/browser-public-remote-follow-e2e.mjs",
    "test:browser:public-multi-remote-follow": "npm run build && node scripts/browser-public-multi-remote-follow-e2e.mjs",
    "test:browser:remote-mobile-session-actions": "npm run build && node scripts/browser-remote-mobile-session-actions-e2e.mjs",
    "test:browser:remote-desktop-tabs": "npm run build && node scripts/browser-remote-desktop-tabs-e2e.mjs",
    "test:browser:public-core": "node scripts/e2e/run-browser-suite.mjs --suite public-core",
    "test:browser:public-core:fake": "node scripts/e2e/run-browser-suite.mjs --suite public-core --fake",
    "test:browser:public": "node scripts/e2e/run-browser-suite.mjs --suite public-full",
    "test:browser:public:fake": "node scripts/e2e/run-browser-suite.mjs --suite public-full --fake",
    "test:browser:android": "npm run build && ANDROID_E2E=1 node scripts/browser-android-dialog-menus-e2e.mjs",
    "live": "node scripts/live-browser.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.3.6",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@noble/hashes": "^2.0.1",
    "@tanstack/query-core": "^5.100.6",
    "@tanstack/virtual-core": "^3.14.0",
    "@tauri-apps/cli": "^2.11.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.58.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "tweetnacl": "^1.0.3",
    "vite": "^7.2.1",
    "zustand": "^5.0.12"
  }
}
